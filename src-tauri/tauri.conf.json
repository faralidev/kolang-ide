{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kolang-ide",
  "version": "0.1.1",
  "identifier": "dev.farali.kolang-ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "node build.cjs --dev",
    "beforeBuildCommand": "node build.cjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "کلنگ — ویرایشگر",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "package": {
    "version": "0.1.1"
  }
}
